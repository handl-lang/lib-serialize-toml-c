--- toml_c.serialize -- serialize a value into a TOML string.
--- toml_c.deserialize -- deserialize a TOML string into a value.
cap "toml_c.serialize"
cap "toml_c.deserialize"
op "toml_c.serialize" : Value ~> String
  guarantee: True
op "toml_c.deserialize" : String ~> Value
  guarantee: True
handle "toml_c.serialize" with rust_toml_c_serialize
handle "toml_c.deserialize" with rust_toml_c_deserialize
